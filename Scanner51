local hasBytecode = type(rawget(getfenv(), "getscriptbytecode")) == "function"

local patterns = {
    {name = "HttpGet",         pat = "HttpGet",    strong = true},
    {name = "GetAsync",        pat = "GetAsync",   strong = true},
    {name = "loadstring",      pat = "loadstring", strong = true},
    {name = "getfenv",         pat = "getfenv",    strong = true},
    {name = "setfenv",         pat = "setfenv",    strong = true},
    {name = "http_request",    pat = "http_request",   strong = true},
    {name = "request(",        pat = "request(",       strong = false},
    {name = "webhook",         pat = "webhook",        strong = true},
    {name = "discord.com/api", pat = "discord.com/api", strong = true},
    {name = "pastebin",        pat = "pastebin",       strong = true},
    {name = "hastebin",        pat = "hastebin",       strong = true},
    {name = "pastes.io",       pat = "pastes.io",      strong = true},
    {name = "raw.githubusercontent", pat = "raw.githubusercontent", strong = true},
    {name = "bytecode",        pat = "bytecode",       strong = true},
    {name = "Kohl",            pat = "Kohl",           strong = false},
    {name = "Adonis",          pat = "Adonis",         strong = false},
}

local knownBadAssets = {
    [162816066]   = "Smol_Script",
    [5408658275]  = "known-backdoor-1",
    [5179641656]  = "known-backdoor-2",
    [11197421823] = "known-backdoor-3",
}

local function scanBlob(blob)
    local hits = {}
    for _, p in ipairs(patterns) do
        if p.pat and blob:find(p.pat, 1, true) then
            hits[#hits+1] = p
        end
    end
    for num in blob:gmatch("require%s*%(?%s*(%d%d%d%d%d+)") do
        local id = tonumber(num)
        if id and id > 100000 and id < 999999999 then
            hits[#hits+1] = {name = "require(" .. id .. ")", strong = true, asset = id}
        end
    end
    for num in blob:gmatch("rbxassetid://(%d+)") do
        local id = tonumber(num)
        if knownBadAssets[id] then
            hits[#hits+1] = {name = "known bad asset " .. knownBadAssets[id], strong = true, asset = id}
        end
    end
    for num in blob:gmatch("(%d%d%d%d%d%d%d%d%d+)") do
        local id = tonumber(num)
        if knownBadAssets[id] then
            hits[#hits+1] = {name = "known bad asset " .. knownBadAssets[id], strong = true, asset = id}
        end
    end
    return hits
end

local scanned, flagged = 0, 0

local function getScriptBlob(inst)
    local ok, src = pcall(function() return inst.Source end)
    if ok and src and #src > 0 then
        return src, "source"
    end
    if hasBytecode then
        local ok2, bc = pcall(getscriptbytecode, inst)
        if ok2 and bc and #bc > 0 then
            return bc, "bytecode"
        end
    end
    return nil, nil
end

local function scanInstance(inst)
    if not inst:IsA("LuaSourceContainer") then return end
    local blob, kind = getScriptBlob(inst)
    if not blob then return end
    scanned = scanned + 1
    local hits = scanBlob(blob)
    if #hits > 0 then
        flagged = flagged + 1
        local strong = false
        for _, h in ipairs(hits) do if h.strong then strong = true break end end
        local color = strong and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 180, 80)
        add("", Color3.fromRGB(120, 120, 140))
        add("[" .. (strong and "!!" or "??") .. "] " .. inst:GetFullName(), color)
        add("     via: " .. kind .. "  | size: " .. #blob, Color3.fromRGB(150, 150, 170))
        for _, h in ipairs(hits) do
            add("     - " .. h.name, strong and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(255, 200, 120))
            if h.asset then
                add("       asset: " .. h.asset, Color3.fromRGB(255, 220, 120))
            end
        end
    end
end

local function getRoots()
    local list = {}
    local names = {
        "ReplicatedStorage", "ReplicatedFirst", "StarterGui",
        "StarterPack", "StarterPlayer", "Players", "Workspace",
        "ServerScriptService", "ServerStorage", "CoreGui",
    }
    for _, n in ipairs(names) do
        local ok, svc = pcall(game.GetService, game, n)
        if ok and svc then list[#list+1] = svc end
    end
    return list
end

local function doScan()
    add("scan start", Color3.fromRGB(255, 100, 100))
    add("place: " .. tostring(game.PlaceId))
    add("bytecode available: " .. tostring(hasBytecode))
    scanned, flagged = 0, 0
    for _, r in ipairs(getRoots()) do
        add("walking: " .. r:GetFullName())
        pcall(function()
            for _, d in ipairs(r:GetDescendants()) do
                scanInstance(d)
            end
        end)
    end
    add("", Color3.fromRGB(120, 120, 140))
    add("scan done", Color3.fromRGB(255, 100, 100))
    add("scanned: " .. scanned .. " | flagged: " .. flagged,
        flagged > 0 and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(140, 255, 140))
    status.Text = " scanned " .. scanned .. " | flagged " .. flagged
    status.TextColor3 = flagged > 0 and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(140, 255, 140)
end

local function doDumpAll()
    if not hasBytecode then
        add("getscriptbytecode not available", Color3.fromRGB(255, 120, 120))
        return
    end
    if type(rawget(getfenv(), "writefile")) ~= "function" then
        add("writefile not available", Color3.fromRGB(255, 120, 120))
        return
    end
    add("dumping", Color3.fromRGB(255, 180, 80))
    local count = 0
    for _, r in ipairs(getRoots()) do
        pcall(function()
            for _, d in ipairs(r:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then
                    local ok2, bc = pcall(getscriptbytecode, d)
                    if ok2 and bc and #bc > 0 then
                        local safe = d:GetFullName():gsub("[/\\:*?\"<>|%.]", "_")
                        local fname = "bc_" .. safe .. "_" .. tostring(count) .. ".txt"
                        pcall(writefile, fname, bc)
                        count = count + 1
                    end
                end
            end
        end)
    end
    add("dumped " .. count .. " scripts", Color3.fromRGB(140, 255, 140))
    status.Text = " dumped " .. count
    status.TextColor3 = Color3.fromRGB(140, 255, 140)
end

