local scanned, flagged = 0, 0

local function scanBlob(blob)
    local hits = {}
    for _, p in ipairs(patterns) do
        if blob:find(p[2], 1, true) then
            hits[#hits+1] = {name = p[1], strong = p[3]}
        end
    end
    for num in blob:gmatch("require%s*%(?%s*(%d%d%d%d%d+)") do
        local id = tonumber(num)
        if id and id > 100000 and id < 999999999 then
            hits[#hits+1] = {name = "require(" .. id .. ")", strong = true, asset = id}
        end
    end
    for id, name in pairs(knownBadAssets) do
        if blob:find(tostring(id), 1, true) then
            hits[#hits+1] = {name = "bad asset " .. name .. " (" .. id .. ")", strong = true, asset = id}
        end
    end
    return hits
end

local function getScriptBlob(inst)
    local ok, src = pcall(function() return inst.Source end)
    if ok and src and #src > 0 then return src, "source" end
    if type(getscriptbytecode) == "function" then
        local ok2, bc = pcall(getscriptbytecode, inst)
        if ok2 and bc and #bc > 0 then return bc, "bytecode" end
    end
    return nil
end

local function scanInstance(inst)
    if not inst:IsA("LuaSourceContainer") then return end
    local blob, kind = getScriptBlob(inst)
    if not blob then return end
    scanned = scanned + 1
    local hits = scanBlob(blob)
    if #hits > 0 then
        flagged = flagged + 1
        local strong = false
        for _, h in ipairs(hits) do if h.strong then strong = true break end end
        local col = strong and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 180, 80)
        add("[" .. (strong and "!!" or "??") .. "] " .. inst:GetFullName(), col)
        add("     " .. kind .. "  " .. #blob .. "b", Color3.fromRGB(150, 150, 170))
        for _, h in ipairs(hits) do
            add("     - " .. h.name, strong and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(255, 200, 120))
        end
    end
end

local function getRoots()
    local list = {}
    for _, n in ipairs({
        "ReplicatedStorage", "ReplicatedFirst", "StarterGui",
        "StarterPack", "StarterPlayer", "Players", "Workspace",
        "ServerScriptService", "ServerStorage", "CoreGui",
        "Chat", "ChatService", "Teams",
    }) do
        local ok, svc = pcall(game.GetService, game, n)
        if ok and svc then list[#list+1] = svc end
    end
    return list
end

local function doScan()
    add("=== source scan ===", Color3.fromRGB(255, 100, 100))
    scanned, flagged = 0, 0
    for _, r in ipairs(getRoots()) do
        pcall(function()
            for _, d in ipairs(r:GetDescendants()) do
                scanInstance(d)
            end
        end)
    end
    add("scanned: " .. scanned .. " | flagged: " .. flagged,
        flagged > 0 and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(140, 255, 140))
    status.Text = " source " .. scanned .. "/" .. flagged
end

local function doMemEnv()
    add("=== env scan ===", Color3.fromRGB(255, 100, 100))
    local function checkTable(tbl, label)
        if type(tbl) ~= "table" then return end
        local count = 0
        for k, v in pairs(tbl) do
            count = count + 1
            if type(k) == "string" then
                for _, p in ipairs(patterns) do
                    if k:find(p[2], 1, true) then
                        add("[env " .. label .. "] key " .. k, Color3.fromRGB(255, 120, 120))
                    end
                end
            end
            if type(v) == "string" and #v > 8 then
                for _, p in ipairs(patterns) do
                    if v:find(p[2], 1, true) then
                        add("[env " .. label .. "] " .. tostring(k) .. " = " .. v:sub(1, 60), Color3.fromRGB(255, 120, 120))
                        break
                    end
                end
            end
            if count % 500 == 0 then task.wait() end
        end
        add("env " .. label .. " - " .. count .. " entries", Color3.fromRGB(150, 150, 170))
    end
    checkTable(rawget(getfenv(), "_G"), "_G")
    checkTable(rawget(getfenv(), "shared"), "shared")
    if type(getgenv) == "function" then
        local ok, g = pcall(getgenv)
        if ok then checkTable(g, "getgenv") end
    end
    add("=== gc scan ===", Color3.fromRGB(255, 100, 100))
    local gc = rawget(getfenv(), "getgc")
    if type(gc) ~= "function" then
        add("no getgc", Color3.fromRGB(255, 120, 120))
        return
    end
    local ok, list = pcall(gc, true)
    if not ok then add("getgc err", Color3.fromRGB(255, 120, 120)) return end
    add("gc: " .. #list .. " objects", Color3.fromRGB(150, 150, 170))
    local total, hits = 0, 0
    for i, obj in ipairs(list) do
        if type(obj) == "table" then
            total = total + 1
            for k, v in pairs(obj) do
                if type(v) == "string" and #v > 12 then
                    for _, p in ipairs(patterns) do
                        if v:find(p[2], 1, true) then
                            hits = hits + 1
                            add("[gc] " .. p[1] .. ": " .. v:sub(1, 70), Color3.fromRGB(255, 100, 100))
                            break
                        end
                    end
                end
            end
        end
        if i % 500 == 0 then task.wait() end
    end
    add("gc done: " .. total .. " tables, " .. hits .. " hits", Color3.fromRGB(150, 150, 170))
end

local hooksInstalled = false
local requiredSeen, urlSeen = {}, {}

local function installHooks()
    if hooksInstalled then
        add("already installed", Color3.fromRGB(255, 220, 120))
        return
    end
    hooksInstalled = true
    local hf = rawget(getfenv(), "hookfunction")
    if type(hf) ~= "function" then
        add("no hookfunction", Color3.fromRGB(255, 120, 120))
        return
    end

    local req = rawget(getfenv(), "require")
    if type(req) == "function" then
        pcall(function()
            hf(req, newcclosure(function(id)
                if type(id) == "number" and id > 100000 and id < 999999999 then
                    if not requiredSeen[id] then
                        requiredSeen[id] = true
                        local known = knownBadAssets[id]
                        add("[require] " .. id .. (known and (" == " .. known) or ""),
                            known and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 220, 120))
                    end
                end
                return req(id)
            end))
        end)
    end

    local ls = rawget(getfenv(), "loadstring")
    if type(ls) == "function" then
        pcall(function()
            hf(ls, newcclosure(function(src, name)
                if type(src) == "string" and #src > 20 then
                    add("[loadstring] " .. #src .. "b: " .. src:sub(1, 60):gsub("[\n\r]", " "),
                        Color3.fromRGB(255, 60, 60))
                    local h2 = scanBlob(src)
                    for _, h in ipairs(h2) do
                        add("    - " .. h.name, Color3.fromRGB(255, 120, 120))
                    end
                end
                return ls(src, name)
            end))
        end)
    end

    local hg = rawget(getfenv(), "HttpGet")
    if type(hg) == "function" then
        pcall(function()
            hf(hg, newcclosure(function(url)
                if type(url) == "string" and not urlSeen[url] then
                    urlSeen[url] = true
                    add("[HttpGet] " .. url, Color3.fromRGB(255, 60, 60))
                end
                return hg(url)
            end))
        end)
    end

    pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if method == "HttpGet" and self == game then
                if type(args[1]) == "string" and not urlSeen[args[1]] then
                    urlSeen[args[1]] = true
                    add("[game:HttpGet] " .. args[1], Color3.fromRGB(255, 60, 60))
                end
            end
            if self == HttpService and (method == "GetAsync" or method == "PostAsync" or method == "RequestAsync" or method == "Get") then
                local u = args[1]
                local url = type(u) == "string" and u or (type(u) == "table" and u.Url) or "?"
                if not urlSeen[url] then
                    urlSeen[url] = true
                    add("[HttpService:" .. method .. "] " .. tostring(url):sub(1, 120), Color3.fromRGB(255, 60, 60))
                end
            end
            return old(self, ...)
        end))
    end)

    add("hooks installed", Color3.fromRGB(140, 255, 140))
    status.Text = " hooks live"
end

